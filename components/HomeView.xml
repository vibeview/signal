    <Group id="row.talk" translation="[96, 570]" />
    <Label id="home.saved.count" text="Saved: 0 shows" translation="[96, 800]" color="0x9AA0ACFF">
      <Font role="font" uri="font:MediumSystemFont" size="30" />
    </Label>
  </children>
</component>
