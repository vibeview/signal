  <interface>
    <field id="shows" type="array" onChange="onShows" />
    <field id="savedCount" type="integer" onChange="onSavedCount" />
    <field id="focusRequest" type="string" alwaysNotify="true" onChange="onFocusRequest" />
    <field id="selectedShow" type="assocarray" alwaysNotify="true" />
    <field id="searchRequested" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Label id="home.title" text="Signal" translation="[96, 56]" color="0xF1EFE8FF">
