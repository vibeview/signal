<?xml version="1.0" encoding="utf-8"?>
<component name="SearchView" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/SearchView.brs" />
  <interface>
    <field id="shows" type="array" onChange="filter" />
    <field id="focusRequest" type="string" alwaysNotify="true" onChange="onFocusRequest" />
    <field id="selectedShow" type="assocarray" alwaysNotify="true" />
    <field id="closeRequested" type="boolean" alwaysNotify="true" />
  </interface>
  <children>
    <Label id="search.title" text="Search" translation="[96, 56]" color="0xF1EFE8FF" font="font:LargeBoldSystemFont" />
    <MiniKeyboard id="search.keyboard" translation="[96, 160]" keyColor="0x9AA0ACFF" focusedKeyColor="0xF1EFE8FF" />
    <Label id="search.results.label" text="Results" translation="[760, 160]" color="0x9AA0ACFF" font="font:MediumBoldSystemFont" />
    <Group id="search.results" translation="[760, 212]" />
    <Label id="search.empty" text="No shows match" translation="[760, 212]" color="0x9AA0ACFF" visible="false" font="font:MediumSystemFont" />
  </children>
</component>
